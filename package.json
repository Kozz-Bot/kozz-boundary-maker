{
	"name": "kozz-boundary-maker",
	"version": "1.1.0",
	"description": "Wrapper library for creation of boundaries compatible with kozz-bot",
	"main": "./dist/index.js",
	"license": "MIT",
	"scripts": {
		"build": "tsc",
		"dev": "npm run build -- --watch & node --watch --watch-path=dist dist/debugIndex.js",
		"start": "npm run build && node --env-file=.env dist/debugIndex.js",
		"test": "jest",
		"docs": "typedoc ./src/index.ts",
		"prepublish": "tsc"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "^4.9.5"
	},
	"dependencies": {
		"@guigalleta/t-parser": "^2.1.1",
		"arcsecond": "^5.0.0",
		"kozz-types": "^0.2.1",
		"socket.io-client": "^4.8.1"
	},
	"_moduleAliases": {
		"src": "dist"
	}
}
